//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    quick-tap-ms = <175>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

&mt {
    quick-tap-ms = <175>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            display-name = "Home Row Mod (Left)";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 7 6 8 9 19 30 31 18 17 16 15 26 28 27 29 37 36 35 34 33 32>;
        };

        hmr: home_row_mod_right {
            display-name = "Home Row Mod (Right)";
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 14 13 12 11 10 20 21 22 23 24 25 32 33 34 35 36 37>;
        };

        hll: home_row_layer_tap_left {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 9 31 19 29 18 17 8 16 15 26 27 28 30 37 36 35 34 33 32>;
        };

        hlr: home_row_layer_tap_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <4 3 2 1 0 20 10 11 21 12 13 14 23 22 24 25 32 33 34 35 36 37>;
        };

        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&sh>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            flavor = "tap-preferred";
        };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp BSPC>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rt_bspc: rt_bspc {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&bspc_del>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };

        space_sentence: space_sentence {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp SPACE>, <&sentence>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_space: lt_space {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&space_sentence>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };
    };

    macros {
        sh: shifted {
            label = "shifted";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;

            #binding-cells = <1>;
        };

        as: autoshift {
            label = "Autoshift";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            #binding-cells = <1>;
        };

        sentence: dot_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp DOT &kp SPACE &sk LSHIFT>;

            label = "DOT_SPACE";
        };
    };

    combos {
        compatible = "zmk,combos";

        lt4 {
            bindings = <&kp LBRC>;
            key-positions = <1 11>;
            layers = <0>;
        };

        lt3 {
            bindings = <&kp LBKT>;
            key-positions = <2 12>;
            layers = <0>;
        };

        lt2 {
            bindings = <&kp LPAR>;
            key-positions = <3 13>;
            layers = <0>;
        };

        lt1 {
            bindings = <&kp LT>;
            key-positions = <4 14>;
            layers = <0>;
        };

        rt1 {
            bindings = <&kp GT>;
            key-positions = <5 15>;
            layers = <0>;
        };

        rt2 {
            bindings = <&kp RPAR>;
            key-positions = <6 16>;
            layers = <0>;
        };

        rt3 {
            bindings = <&kp RBKT>;
            key-positions = <7 17>;
            layers = <0>;
        };

        rt4 {
            bindings = <&kp RBRC>;
            key-positions = <8 18>;
            layers = <0>;
        };

        lb4 {
            bindings = <&kp BSLH>;
            key-positions = <11 22>;
            layers = <0>;
        };

        lb3 {
            bindings = <&kp GRAVE>;
            key-positions = <12 23>;
            layers = <0>;
        };

        lb2 {
            bindings = <&kp SEMI>;
            key-positions = <13 24>;
            layers = <0>;
        };

        lb1 {
            bindings = <&kp ESC>;
            key-positions = <14 25>;
            layers = <0>;
        };

        rb1 {
            bindings = <&kp RET>;
            key-positions = <15 26>;
            layers = <0>;
        };

        rb2 {
            bindings = <&kp COLON>;
            key-positions = <16 27>;
            layers = <0>;
        };

        rb3 {
            bindings = <&kp TILDE>;
            key-positions = <17 28>;
            layers = <0>;
        };

        rb4 {
            bindings = <&kp FSLH>;
            key-positions = <18 29>;
            layers = <0>;
        };

        launcher {
            bindings = <&kp LG(SPACE)>;
            key-positions = <11 13>;
            layers = <0>;
        };

        function {
            bindings = <&sl 3>;
            key-positions = <6 7 8>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
       &kp Q        &kp W        &kp F  &kp P              &kp B            &kp J      &kp L             &kp U               &kp Y            &as SQT
       &hml LGUI A  &hml LALT R  &kp S  &hll 1 T           &kp G            &kp M      &hlr 2 N          &kp E               &hmr LALT I      &hmr RGUI O
&none  &kp Z        &kp X        &kp C  &kp D              &kp V            &kp K      &kp H             &as_ht QMARK COMMA  &as_ht EXCL DOT  &mt ESC RET  &none
                                 &none  &lt_space LCTRL 0  &mt LSHFT TAB    &sk RSHFT  &rt_bspc RCTRL 0  &none
            >;
        };

        nav {
            display-name = "navigation";
            bindings = <
        &trans         &trans    &trans     &trans     &trans    &kp HOME         &kp PG_DN        &kp PG_UP  &kp END    &kp INS
        &hml LGUI ESC  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp LEFT         &kp DOWN         &kp UP     &kp RIGHT  &trans
&trans  &trans         &trans    &trans     &trans     &trans    &kp PSCRN        &kp LC(PSCRN)    &trans     &trans     &trans   &trans
                                 &trans     &trans     &trans    &mt RSHFT MINUS  &mt RCTRL UNDER  &trans
            >;
        };

        num {
            display-name = "number";
            bindings = <
        &trans           &kp FSLH  &kp PLUS  &kp EQUAL        &kp TILDE          &trans  &trans     &trans     &trans    &trans
        &as_ht GRAVE N1  &as N2    &as N3    &as N4           &as N5             &trans  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI
&trans  &as N6           &as N7    &as N8    &as_ht BSLH N9   &as_ht PIPE N0     &trans  &trans     &trans     &trans    &trans    &trans
                                   &trans    &mt LCTRL UNDER  &mt LSHFT MINUS    &trans  &trans     &trans
            >;
        };

        fun {
            display-name = "fun";
            bindings = <
        &kp F11  &kp F12  &kp F13  &kp F14  &kp F15    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
        &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &trans        &trans        &trans        &trans        &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10    &trans        &trans        &trans        &trans        &trans        &bt BT_CLR
                          &trans   &trans   &trans     &trans        &trans        &trans
            >;
        };
    };
};
