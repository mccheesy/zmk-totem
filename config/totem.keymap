#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    quick-tap-ms = <175>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

&mt {
    quick-tap-ms = <175>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            display-name = "Home Row Mod (Left)";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 7 6 8 9 19 30 31 18 17 16 15 26 28 27 29 37 36 35 34 33 32>;
        };

        hmr: home_row_mod_right {
            display-name = "Home Row Mod (Right)";
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 14 13 12 11 10 20 21 22 23 24 25 32 33 34 35 36 37>;
        };

        hll: home_row_layer_tap_left {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 9 31 19 29 18 17 8 16 15 26 27 28 30 37 36 35 34 33 32>;
        };

        hlr: home_row_layer_tap_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <4 3 2 1 0 20 10 11 21 12 13 14 23 22 24 25 32 33 34 35 36 37>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lbrc {
            bindings = <&kp LBRC>;
            key-positions = <1 11>;
            layers = <0>;
        };

        lbkt {
            bindings = <&kp LBKT>;
            key-positions = <2 12>;
            layers = <0>;
        };

        lpar {
            bindings = <&kp LPAR>;
            key-positions = <3 13>;
            layers = <0>;
        };

        lt {
            bindings = <&kp LT>;
            key-positions = <4 14>;
            layers = <0>;
        };

        gt {
            bindings = <&kp GT>;
            key-positions = <5 15>;
            layers = <0>;
        };

        rpar {
            bindings = <&kp RPAR>;
            key-positions = <6 16>;
            layers = <0>;
        };

        rbkt {
            bindings = <&kp RBKT>;
            key-positions = <7 17>;
            layers = <0>;
        };

        rbrc {
            bindings = <&kp RBRC>;
            key-positions = <8 18>;
            layers = <0>;
        };

        launcher_l {
            bindings = <&kp LG(SPACE)>;
            key-positions = <11 13>;
        };

        launcher_r {
            bindings = <&kp RG(SPACE)>;
            key-positions = <16 18>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
           &kp Q        &kp W        &hll 3 F      &kp P            &kp B            &kp J          &kp L           &hll 3 U      &kp Y        &kp SQT
           &hml LGUI A  &hml LALT R  &kp S         &hll 1 T         &kp G            &kp M          &hlr 2 N        &kp E         &hmr LALT I  &hmr RGUI O
&kp GRAVE  &kp Z        &kp X        &kp C         &kp D            &kp V            &kp K          &kp H           &kp COMMA     &kp DOT      &kp FSLH     &kp BSLH
                                     &mt LALT ESC  &mt LCTRL SPACE  &mt LSHFT TAB    &mt RSHFT RET  &mt RCTRL BSPC  &mt LALT DEL
            >;
        };

        nav {
            display-name = "navigation";
            bindings = <
        &trans          &trans           &kp PIPE   &trans           &trans             &kp HOME         &kp PG_DN        &kp PG_UP  &kp END    &kp INS
        &hml LGUI SEMI  &hml LALT GRAVE  &kp COLON  &trans           &trans             &kp LEFT         &kp DOWN         &kp UP     &kp RIGHT  &trans
&trans  &trans          &trans           &kp BSLH   &trans           &trans             &kp PSCRN        &kp LC(PSCRN)    &trans     &trans     &trans   &trans
                                         &trans     &mt LCTRL UNDER  &mt LSHFT MINUS    &mt RSHFT MINUS  &mt RCTRL UNDER  &trans
            >;
        };

        num {
            display-name = "number";
            bindings = <
        &none   &kp FSLH  &kp PLUS  &kp EQUAL        &kp PIPE           &trans           &trans           &kp PIPE   &trans           &trans
        &kp N1  &kp N2    &kp N3    &kp N4           &kp N5             &trans           &trans           &kp COLON  &hmr LALT GRAVE  &hmr RGUI SEMI
&trans  &kp N6  &kp N7    &kp N8    &kp N9           &kp N0             &trans           &trans           &kp BSLH   &trans           &trans          &trans
                          &trans    &mt LCTRL UNDER  &mt LSHFT MINUS    &mt LSHFT MINUS  &mt LCTRL UNDER  &trans
            >;
        };

        fun {
            display-name = "fun";
            bindings = <
        &kp F11  &kp F12  &kp F13  &kp F14  &kp F15    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
        &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &trans        &trans        &trans        &trans        &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10    &trans        &trans        &trans        &trans        &trans        &bt BT_CLR
                          &trans   &trans   &trans     &trans        &trans        &trans
            >;
        };
    };
};
