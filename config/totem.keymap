//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
 
&lt {
   tapping-term-ms = <220>;
   quick-tap-ms = <220>;
   flavor = "tap-preferred";
    require-prior-idle-ms = <150>;
};

&mt {
   tapping-term-ms = <220>;
   quick-tap-ms = <220>;
   flavor = "tap-preferred";
    require-prior-idle-ms = <150>;
};

&sk {
    release-after-ms = <900>;
    quick-release;
};

&sl {
    ignore-modifiers;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            display-name = "Home Row Mod (Left)";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 7 6 8 9 19 30 31 18 17 16 15 26 28 27 29 37 36 35 34 33 32>;
        };

        hmr: home_row_mod_right {
            display-name = "Home Row Mod (Right)";
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 14 13 12 11 10 20 21 22 23 24 25 32 33 34 35 36 37>;
        };

        hll: home_row_layer_tap_left {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 9 31 19 29 18 17 8 16 15 26 27 28 30 37 36 35 34 33 32>;
        };

        hlr: home_row_layer_tap_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <4 3 2 1 0 20 10 11 21 12 13 14 23 22 24 25 32 33 34 35 36 37>;
        };

        btclr_ht: bluetooth_clear_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Bluetooth Clear Hold-Tap";
            bindings = <&btclrall>, <&btclr>;

            #binding-cells = <2>;
            tapping-term-ms = <5000>;
            flavor = "tap-preferred";
        };

        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&sh>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            flavor = "tap-preferred";
        };

        numd: num_dance {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Num Dance";
            bindings = <&sl 2>, <&num_word 2>;

            #binding-cells = <0>;
            tapping-term-ms = <200>;
        };

        // Tap: num_word | double-tap: sticky num-layer | hold: num-layer
        // see: https://github.com/urob/zmk-config/config/base.keymap:116-121
        mnum: magic_num {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Magic Number Layer-Tap";
            bindings = <&mo>, <&numd>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
        };

        shft_cpwd: shift_capsword {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Shift Caps-Word";
            bindings = <&sk LSHFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mshft: magic_shift {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Magic Shift";
            bindings = <&kp>, <&shft_cpwd>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
			require-prior-idle-ms = <150>;
            flavor = "balanced";
        };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp BSPC>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        space_sentence: space_sentence {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp SPACE>, <&sentence>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        spc_tap: spc_tap {
            compatible = "zmk,behavior-hold-tap";
			display-name = "Space-Tap";
            bindings = <&kp>, <&space_sentence>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };

        bsp_tap: bsp_tap {
            compatible = "zmk,behavior-hold-tap";
			display-name = "Backspace-Tap";
            bindings = <&kp>, <&bspc_del>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };
    };

    macros {
        sh: shifted {
            label = "shifted";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;

            #binding-cells = <1>;
        };

        as: autoshift {
            label = "Autoshift";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            #binding-cells = <1>;
        };

        sentence: sentence {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp DOT &kp SPACE &sk LSHFT>;

            label = "SENTENCE";
        };

        btclr: bluetooth_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&bt BT_CLR>;
        };

        btclrall: bluetooth_clear_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&bt BT_CLR_ALL>;
        };
    };

    combos {
        compatible = "zmk,combos";
        lt4 {
            bindings = <&kp LBRC>;
            key-positions = <1 11>;
        };

        lt3 {
            bindings = <&kp LBKT>;
            key-positions = <2 12>;
        };

        lt2 {
            bindings = <&kp LPAR>;
            key-positions = <3 13>;
        };

        lt1 {
            bindings = <&kp LT>;
            key-positions = <4 14>;
        };

        rt1 {
            bindings = <&kp GT>;
            key-positions = <5 15>;
        };

        rt2 {
            bindings = <&kp RPAR>;
            key-positions = <6 16>;
        };

        rt3 {
            bindings = <&kp RBKT>;
            key-positions = <7 17>;
        };

        rt4 {
            bindings = <&kp RBRC>;
            key-positions = <8 18>;
        };

        lb4 {
            bindings = <&kp GRAVE>;
            key-positions = <11 21>;
        };

        lb3 {
            bindings = <&kp SEMI>;
            key-positions = <12 22>;
        };

        lb2 {
            bindings = <&kp BSLH>;
            key-positions = <13 23>;
        };

        lb1 {
            bindings = <&kp UNDER>;
            key-positions = <14 24>;
        };

        rb1 {
            bindings = <&kp MINUS>;
            key-positions = <15 25>;
        };

        rb2 {
            bindings = <&kp FSLH>;
            key-positions = <16 26>;
        };

        rb3 {
            bindings = <&kp COLON>;
            key-positions = <17 27>;
        };

        rb4 {
            bindings = <&kp TILDE>;
            key-positions = <18 28>;
        };

        launcher {
            bindings = <&kp LG(SPACE)>;
            key-positions = <11 13>;
        };

        function {
            bindings = <&sl 3>;
            key-positions = <6 8>;
        };

		esc {
			bindings = <&kp ESC>;
			key-positions = <11 13>;
		};
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
       &kp Q        &kp W        &kp F  &kp P             &kp B         &kp J         &kp L             &kp U               &kp Y            &as SQT
       &hml LGUI A  &hml LALT R  &kp S  &hll 1 T          &kp G         &kp M         &kp N             &kp E               &hmr LALT I      &hmr RGUI O
&none  &kp Z        &kp X        &kp C  &kp D             &kp V         &kp K         &kp H             &as_ht QMARK COMMA  &as_ht EXCL DOT  &mnum 2 0    &none
                                 &none  &spc_tap LCTRL 0  &mshft 0 TAB  &mshft 0 RET  &bsp_tap RCTRL 0  &none
            >;
        };

        navigation {
            display-name = "nav";
            bindings = <
        &trans   &trans    &trans     &trans     &trans  &kp HOME   &kp PG_DN      &kp PG_UP  &kp END    &kp INS
        &sk LGUI &sk LALT  &sk LCTRL  &sk LSHFT  &trans  &kp LEFT   &kp DOWN       &kp UP     &kp RIGHT  &trans
&trans  &trans   &trans    &kp BSLH   &trans     &trans  &kp PSCRN  &kp LC(PSCRN)  &trans     &trans     &trans   &trans
                           &trans     &trans     &trans  &trans     &trans         &trans
            >;
        };

        number {
            display-name = "num";
            bindings = <
        &trans           &kp FSLH  &kp PLUS  &kp EQUAL       &none           &trans  &trans     &trans     &trans    &trans
        &as_ht GRAVE N1  &as N2    &as N3    &as N4          &as N5          &trans  &sk RSHFT  &sk RCTRL  &sk LALT  &sk RGUI
&trans  &as N6           &as N7    &as N8    &as_ht BSLH N9  &as_ht PIPE N0  &trans  &trans     &trans     &trans    &trans    &trans
                                   &trans    &trans          &trans          &trans  &trans     &trans
            >;
        };

        function {
            display-name = "fun";
            bindings = <
        &kp F11  &kp F12  &kp F13  &kp F14  &kp F15    &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
        &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &trans         &sk RSHFT     &sk RCTRL     &sk LALT      &sk RGUI
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10    &btclr_ht 0 0  &trans        &trans        &trans        &trans        &trans
                          &trans   &trans   &trans     &trans         &trans        &trans
            >;
        };
    };
};
